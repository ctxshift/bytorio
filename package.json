{
  "name": "console-dev-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,html}\" package.json .prettierrc.json",
    "format:check": "prettier --check \"**/*.{js,mjs,html}\" package.json .prettierrc.json",
    "serve": "node tools/serve.mjs",
    "test:odin": "node tools/verify-odin.mjs",
    "serve:odin": "node tools/serve.mjs build/odin-player/web",
    "build:rpg": "pwsh -NoProfile -File tools/build-rpg.ps1",
    "test:rpg": "node experiments/luau-executor/benchmark.mjs --verify",
    "serve:rpg": "node tools/serve.mjs build/unified-player/web",
    "build:unified": "pwsh -NoProfile -File tools/build-unified-prototype.ps1",
    "bench:unified": "node experiments/luau-executor/benchmark.mjs",
    "serve:unified": "node tools/serve.mjs build/unified-player/web",
    "test:display": "node tools/verify-display.mjs",
    "build:racing": "pwsh -NoProfile -File tools/build-racing.ps1",
    "test:racing": "node tools/verify-racing.mjs",
    "bench:racing": "node experiments/racing/benchmark.mjs",
    "serve:racing": "node tools/serve.mjs build/racing-player/web",
    "console": "node tools/console.mjs",
    "test:sdk": "node tools/verify-sdk.mjs && node tools/verify-sdk-cli.mjs",
    "test:cartridge": "node tools/verify-cartridge.mjs",
    "generate:resources": "node tools/generate-resource-schema.mjs",
    "test:resources": "node tools/verify-resources.mjs",
    "test:graphics": "node tools/verify-graphics.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  }
}
