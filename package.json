{
  "name": "bytorio",
  "displayName": "Bytorio",
  "description": "A portable fantasy game console with Luau and Odin SDKs",
  "homepage": "https://bytor.io",
  "bin": {
    "byt": "tools/byt.mjs"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "mise run lint",
    "lint:fix": "eslint . --fix",
    "format": "mise run format",
    "format:check": "mise run format:check",
    "serve": "node tools/serve.mjs",
    "test:odin": "mise run test:odin",
    "serve:odin": "node tools/serve.mjs build/odin-player/web",
    "build:rpg": "mise run //examples/rpg:build",
    "test:rpg": "mise run //examples/rpg:test",
    "serve:rpg": "mise run //examples/rpg:serve",
    "build:unified": "mise run //examples/rpg:build",
    "bench:unified": "mise run //examples/rpg:benchmark",
    "serve:unified": "mise run //examples/rpg:serve",
    "test:display": "mise run test:display",
    "build:racing": "mise run //examples/racing:build",
    "test:racing": "mise run //examples/racing:test",
    "bench:racing": "mise run //examples/racing:benchmark",
    "serve:racing": "mise run //examples/racing:serve",
    "byt": "node tools/byt.mjs",
    "test:sdk": "mise run test:sdk",
    "test:cartridge": "mise run test:cartridge",
    "generate:resources": "mise run generate",
    "test:resources": "mise run test:resources",
    "test:audio": "mise run test:audio",
    "test:synthesis": "mise run test:synthesis",
    "test:graphics": "mise run test:graphics",
    "lint:js": "eslint .",
    "lint:odin": "mise exec -- node tools/lint-code.mjs odin",
    "lint:cpp": "mise run lint:cpp",
    "format:cpp": "mise run format:cpp",
    "lint:luau": "mise exec -- node tools/lint-code.mjs luau",
    "format:js": "prettier --write \"**/*.{js,mjs,ts,html}\" \"site/*.css\" package.json .prettierrc.json",
    "format:js:check": "prettier --check \"**/*.{js,mjs,ts,html}\" \"site/*.css\" package.json .prettierrc.json",
    "format:odin": "mise exec -- node tools/format-code.mjs odin",
    "format:luau": "mise exec -- node tools/format-code.mjs luau",
    "build:odin": "mise run build:odin",
    "test": "mise run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.13.0",
    "marked": "17.0.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "tar": "7.5.22"
  }
}
