{
  "name": "console-dev-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "mise run lint",
    "lint:fix": "eslint . --fix",
    "format": "mise run format",
    "format:check": "mise run format:check",
    "serve": "node tools/serve.mjs",
    "test:odin": "mise run test:odin",
    "serve:odin": "node tools/serve.mjs build/odin-player/web",
    "build:rpg": "mise run build:rpg",
    "test:rpg": "mise run test:rpg",
    "serve:rpg": "node tools/serve.mjs build/unified-player/web",
    "build:unified": "mise run build:rpg",
    "bench:unified": "node experiments/luau-executor/benchmark.mjs",
    "serve:unified": "node tools/serve.mjs build/unified-player/web",
    "test:display": "mise run test:display",
    "build:racing": "mise run build:racing",
    "test:racing": "mise run test:racing",
    "bench:racing": "node experiments/racing/benchmark.mjs",
    "serve:racing": "node tools/serve.mjs build/racing-player/web",
    "console": "node tools/console.mjs",
    "test:sdk": "mise run test:sdk",
    "test:cartridge": "mise run test:cartridge",
    "generate:resources": "mise run generate",
    "test:resources": "mise run test:resources",
    "test:graphics": "mise run test:graphics",
    "lint:js": "eslint .",
    "lint:odin": "mise exec -- node tools/lint-code.mjs odin",
    "lint:cpp": "mise run lint:cpp",
    "format:cpp": "mise run format:cpp",
    "lint:luau": "mise exec -- node tools/lint-code.mjs luau",
    "format:js": "prettier --write \"**/*.{js,mjs,html}\" package.json .prettierrc.json",
    "format:js:check": "prettier --check \"**/*.{js,mjs,html}\" package.json .prettierrc.json",
    "format:odin": "mise exec -- node tools/format-code.mjs odin",
    "format:luau": "mise exec -- node tools/format-code.mjs luau",
    "build:odin": "mise run build:odin",
    "test": "mise run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  }
}
