draw :: proc(pass: gfx.Pass, instance: ^Instance, root := g.IDENTITY, locals: []g.Matrix = nil) {
    assert(instance.alive, "Model instance is destroyed")
    assert(len(locals) == 0 || len(locals) == NODE_COUNT, "Invalid local transform count")
    world: [NODE_COUNT]g.Matrix
    for i in 0 ..< NODE_COUNT {
        local_model := locals[i] if len(locals) != 0 else node_locals[i]
        parent := root if parents[i] < 0 else world[parents[i]]
        world[i] = g.multiply(parent, local_model)
        switch i {
        case 0:
            g.draw_textured(pass, instance.meshes[0], instance.materials[0], world[0])
        case 1:
            g.draw_textured(pass, instance.meshes[1], instance.materials[0], world[1])
        case 2:
            g.draw_textured(pass, instance.meshes[2], instance.materials[0], world[2])
        case 3:
            g.draw_textured(pass, instance.meshes[3], instance.materials[0], world[3])
        case 4:
            g.draw_textured(pass, instance.meshes[3], instance.materials[0], world[4])
        case 5:
            g.draw_textured(pass, instance.meshes[3], instance.materials[0], world[5])
        case 6:
            g.draw_textured(pass, instance.meshes[3], instance.materials[0], world[6])
        case 7:
            g.draw_textured(pass, instance.meshes[4], instance.materials[0], world[7])
        case 8:
            g.draw_textured(pass, instance.meshes[5], instance.materials[0], world[8])
        case 9:
            g.draw_textured(pass, instance.meshes[6], instance.materials[0], world[9])
        }
    }
}

destroy :: proc(instance: ^Instance) {
    if !instance.alive { return }
    for mesh in instance.meshes { g.destroy(mesh) }
    for material in instance.materials { g.destroy(material) }
    for texture in instance.textures { gfx.destroy(texture) }
    instance.alive = false
}
